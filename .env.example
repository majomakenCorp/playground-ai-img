# =============================================================================
# AI Playground — environment template
# Copy to `.env` (already gitignored) and fill in. Validated by `src/lib/env.ts`
# at boot — the app refuses to start if any required value is missing/short.
# Compose reads the same `.env` via `env_file:` in `docker-compose.yml`.
# =============================================================================

# --- Auth ---------------------------------------------------------------------
# Shared password used to log into the playground. Pick something strong.
APP_PASSWORD=change-me-strong-shared-password

# 32+ random bytes used to sign session JWTs. Rotate by redeploy.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-32-plus-byte-random-string

# Public origin the app is served from. Used for Origin/Referer checks.
# Local Compose:  http://localhost:3030
# Prod:           https://playground.example.com
APP_ORIGIN=http://localhost:3030

# Host port published by docker-compose (container always listens on 3000).
# Override if 3030 is already in use on your machine.
HOST_PORT=3030

# --- Provider API keys --------------------------------------------------------
# Google Gemini (Nano Banana 2 / Gemini 3 Flash Image).
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Recraft. https://www.recraft.ai/  (account → API)
RECRAFT_API_KEY=

# --- MongoDB ------------------------------------------------------------------
# Connection string used by the app at runtime. Hostname `mongo` is the Compose
# service name; if you run Mongo elsewhere, point this at it.
MONGODB_URI=mongodb://app:replace-mongo-app-password@mongo:27017/playground?authSource=playground

# Compose-only: bootstraps the Mongo root user on first boot of the volume.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-mongo-root-password

# Compose-only: the app-scoped Mongo user created by the init script.
# Must match the username + password embedded in MONGODB_URI above.
MONGO_APP_USERNAME=app
MONGO_APP_PASSWORD=replace-mongo-app-password

# --- Image storage (Cloudflare R2) -------------------------------------------
# When all four R2_* vars are set, generated images are written to the R2
# bucket instead of IMAGES_DIR. Leave them unset to use local FS (Docker).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=molt-ai-test
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Optional -----------------------------------------------------------------
# Override generated-image storage location (default: ./generate-images).
# Ignored when R2_* are configured.
# IMAGES_DIR=./generate-images

# Server port (defaults to 3000).
# PORT=3000

# Standard Node env. Compose/builds set this themselves; leave unset locally.
# NODE_ENV=production

# --- Host bridge for Claude Code CLI -----------------------------------------
# The `app` container can invoke the host's `claude` CLI to refine brand briefs
# into logo prompts. The CLI binary, its node_modules, and your ~/.claude
# credentials are bind-mounted in docker-compose.yml. To match host file
# ownership, set HOST_UID/HOST_GID to your shell user:
#     echo "HOST_UID=$(id -u)" >> .env
#     echo "HOST_GID=$(id -g)" >> .env
# See docs/sdd-claude-provider.md for the full story.
HOST_UID=1000
HOST_GID=1000

# Toggle the "Refinar con Claude" UI/endpoint. Set to "false" on hosts without
# the bind-mounted CLI (e.g. CI, or any deploy that doesn't ship the host
# subscription credentials).
CLAUDE_REFINE_ENABLED=true

# Absolute path to the CLI binary inside the container. Set by Compose to
# /usr/local/bin/claude; only override if you bind-mount the binary elsewhere.
# CLAUDE_CLI_PATH=/usr/local/bin/claude
